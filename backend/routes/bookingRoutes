
const express = require("express");
const router = express.Router();

const {
    createBooking,
    getMyBookings,
    getBookingById,
    verifyTicket
} = require("../controllers/bookingController");

const {
    protect,
    authorize
} = require("../middleware/authMiddleware");

// ADMIN: Verify QR ticket
router.post(
    "/verify",
    protect,
    authorize("admin"),
    verifyTicket
);

// STUDENT: Create booking
router.post(
    "/",
    protect,
    authorize("student"),
    createBooking
);

// STUDENT: Get own bookings
router.get(
    "/my-bookings",
    protect,
    authorize("student"),
    getMyBookings
);

// STUDENT: Get one booking
router.get(
    "/:id",
    protect,
    authorize("student"),
    getBookingById
);

module.exports = router;
